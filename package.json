{
  "name": "amaantraders-atelier",
  "version": "2.0.0",
  "private": true,
  "description": "AMAANTRADERS — premium outerwear commerce experience",
  "scripts": {
    "dev": "concurrently -k \"node server.js\" \"vite --host 0.0.0.0\"",
    "dev:web": "vite --host 0.0.0.0",
    "api": "node server.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js",
    "check": "tsc -b --pretty false && node --check server.js && node --check security-check.js",
    "security-check": "node security-check.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "motion": "^14.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
