# AmaanTrader store alerts. Copy to .env and add real credentials only on your server.
# Empty values keep notifications/payment disabled; order requests can still be recorded.

# Store notification recipient email (Resend)
STORE_NOTIFICATION_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=

# Meta WhatsApp Cloud API (owner receives store alerts)
WHATSAPP_TO=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=store_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Create a Meta-approved utility template named store_alert with one body variable: {{1}}

# Optional Razorpay Checkout + Webhook. Leave empty for order-request-only mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
